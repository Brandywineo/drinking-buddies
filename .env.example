# Server-side only. Never prefix secrets with VITE_.
APP_URL=http://localhost:3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drinking_buddies

# Email delivery worker/provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Drinking Buddies <hello@example.com>

# OAuth providers (planned)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMS/phone verification provider (planned)
SMS_PROVIDER=
SMS_API_KEY=

# M-Pesa Daraja (sandbox first)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Daraja B2C (sandbox; encrypted security credential is supplied by Safaricom)
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=
MPESA_B2C_TIMEOUT_URL=

# Comma-separated normalized admin email addresses; server-side only
ADMIN_EMAILS=

# Daraja reversal (sandbox only; values and identifier type must be approved by Safaricom)
MPESA_REVERSAL_INITIATOR_NAME=
MPESA_REVERSAL_SECURITY_CREDENTIAL=
MPESA_REVERSAL_RECEIVER_PARTY=
MPESA_REVERSAL_IDENTIFIER_TYPE=
MPESA_REVERSAL_RESULT_URL=
MPESA_REVERSAL_TIMEOUT_URL=
