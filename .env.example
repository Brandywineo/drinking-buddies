# App
APP_URL=http://localhost:5173
APP_ENV=development

# PostgreSQL (server-side only)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drinking_buddies

# Authentication - configure providers before enabling sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Email provider - keep credentials server-side
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Drinking Buddies <hello@example.com>

# M-Pesa Daraja - sandbox first; never commit real credentials
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=