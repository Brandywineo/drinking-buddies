# Server-side only. Never prefix secrets with VITE_.
APP_URL=http://localhost:3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drinking_buddies

# Email delivery worker/provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Drinking Buddies <hello@example.com>

# OAuth providers (planned)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMS/phone verification provider (planned)
SMS_PROVIDER=
SMS_API_KEY=

# M-Pesa Daraja (sandbox first)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
